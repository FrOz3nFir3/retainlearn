# =================================================================

# Cloudflare Pages Custom Headers Configuration

# =================================================================

# This file instructs Cloudflare's edge network on what HTTP headers to add to responses for your site.

# It is a powerful way to enforce security policies.

/*
Cross-Origin-Opener-Policy: same-origin-allow-popups
Cross-Origin-Embedder-Policy: require-corp
Cross-Origin-Resource-Policy: same-origin
Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com https://static.cloudflareinsights.com 'sha256-4M7YLRfpiT7OgYPI5Pfd6o8C/FW4IFO/m1CQiVoDLS4='; frame-src 'self' https://accounts.google.com https://www.googleapis.com; connect-src 'self' https://accounts.google.com https://www.googleapis.com https://uselessfacts.jsph.pl https://api.retainlearn.com https://cloudflareinsights.com; style-src 'self' https://accounts.google.com 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;
Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
Referrer-Policy: strict-origin-when-cross-origin
X-Content-Type-Options: nosniff
X-Frame-Options: SAMEORIGIN
X-XSS-Protection: 0
Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), gyroscope=(), accelerometer=(), magnetometer=(), fullscreen=(self)

# Content-hashed build assets — filename changes when content changes,
# so they are safe to cache forever with no revalidation round trip.
/assets/*
Cache-Control: public, max-age=31536000, immutable
