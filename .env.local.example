# Local development. Copy this file to `.env.local` (git ignores it). It loads before `.env` and wins, so a server
# started on your machine uses local databases and never production's, whatever `.env` holds.
# See README, "Local development".

NODE_ENV=development
PORT=3000

# MongoDB on your machine. `retainlearn` is the working copy: `npm run db:copy` refills it from another local
# database (e.g. an imported copy of production called `repetitions`), and `npm run db:seed` fills an empty one.
MONGO_URI=mongodb://localhost:27017/retainlearn

# Redis from docker-compose.yml (`docker compose up -d`).
REDIS_URI=redis://localhost:6379
REDIS_CACHE_ENABLED=true
REDIS_CACHE_DEBUG_ENABLED=false

# No proxy in front locally.
ENABLE_PROXY=false

# Local-only secrets: never production's.
ACCESS_TOKEN_SECRET=local-only-access-token-secret
REFRESH_TOKEN_SECRET=local-only-refresh-token-secret
COOKIE_SECRET=local-only-cookie-secret
